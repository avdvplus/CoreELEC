#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-or-later

# Re-apply UAS after resume from suspend.
#
# The 4.9 driver core emits no bind/unbind uevents (KOBJ_BIND is 4.14+), so
# 99-uas-rebind.rules never fires on hot-plug. A USB device that
# re-enumerates across suspend - common for USB3 SSDs/enclosures that get
# reset or lose power in S2 - is re-probed by usb-storage and never handed
# back to uas. Re-run the boot-time rebind after resume to restore it.
#
# systemd-sleep invokes us as:  <hook> <pre|post> <suspend|hibernate|...>

[ "$1" = "post" ] || exit 0
[ -e /storage/.config/uas.enabled ] || exit 0

# stdout lands in the systemd-suspend.service journal, so a single line
# lets the user confirm the hook fired (journalctl -u systemd-suspend).
echo "uas-resume: re-applying UAS after resume"

# USB re-enumeration after resume is asynchronous and can be staggered, so
# settle the udev queue then make a few bounded passes. uas-boot rechecks
# the marker, (re)loads uas, and rebinds every usb-storage interface that
# supports UAS; it is idempotent, so already-uas devices are left alone.
udevadm settle --timeout=10 2>/dev/null

attempt=1
while : ; do
  /usr/lib/libreelec/uas-boot
  [ "${attempt}" -ge 6 ] && break
  attempt=$((attempt + 1))
  sleep 1
done
