[Unit]
Description=Kodi userdata/addon RAM setup
DefaultDependencies=no
After=local-fs.target
Before=kodi.service kodi-autostart.service kodi-tmpfs-log-setup.service
RequiresMountsFor=/storage /run

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/coreelec/kodi-data-ram-up.sh
ExecStop=/usr/lib/coreelec/kodi-data-ram-down.sh

[Install]
WantedBy=kodi.service
